# Stand environment. `./init-env.sh` copies this file to .env with fresh random secrets;
# .env holds passwords and is never committed.

# --- public address ---
# A domain (vds.example.com) gets HTTPS from Let's Encrypt; ":80" serves plain HTTP when another
# proxy in front of the stand terminates TLS.
VDS_SITE_ADDRESS=vds.example.com
VDS_HTTP_PUBLISH=80
VDS_HTTPS_PUBLISH=443
VDS_CORS_ALLOWED_ORIGINS=

# Pin a version tag on servers to make upgrades and rollbacks explicit.
VDS_IMAGE=ghcr.io/a1tsignature/vds-provider-grabber:1.0.0

VDS_DB_NAME=vds
VDS_DB_USER=vds
VDS_DB_PASSWORD=__GENERATE__

# Use at least 32 characters. Rotating this secret invalidates existing sessions.
VDS_JWT_SECRET=__GENERATE__
VDS_JWT_TTL_HOURS=24
# Created once, on the first start against an empty database. 12+ characters.
VDS_BOOTSTRAP_ADMIN_USERNAME=admin
VDS_BOOTSTRAP_ADMIN_PASSWORD=__GENERATE__

# Create this EDITOR account once through POST /api/v1/admin/users.
VDS_ENRICH_USERNAME=enricher
VDS_ENRICH_PASSWORD=__GENERATE__
# 0 drains the queue in one JVM. 1 runs one batch of 10 per JVM.
VDS_ENRICH_BATCHES_PER_JVM=0
# Optional; shown in the crawler's User-Agent so site owners can reach us.
# VDS_CRAWLER_CONTACT_URL=https://vds.example.com/contact

VDS_DISCOVERY_ENABLED=false
VDS_DISCOVERY_SEARCH_API_KEY=
VDS_DISCOVERY_MAX_CREDITS_PER_MONTH=50
VDS_DISCOVERY_MAX_SOURCES=500

VDS_FX_REFRESH_HOURS=12

VDS_APP_MEM_LIMIT=768m
VDS_DB_MEM_LIMIT=512m
VDS_ENRICH_MEM_LIMIT=512m
