# Скопируйте в .env и заполните значения. Docker Compose читает .env автоматически.
# При запуске JAR напрямую сначала экспортируйте переменные из .env в окружение процесса.

# Порты хоста и имя базы для Docker Compose.
# VDS_APP_PORT=8080
# VDS_DB_PORT=5432
# VDS_DB_NAME=vds

# Ключ Tavily: бесплатный тариф, без привязанного способа оплаты (см. README, раздел 7.4).
VDS_DISCOVERY_SEARCH_API_KEY=

VDS_DB_URL=jdbc:postgresql://localhost:5432/vds
VDS_DB_USER=vds
VDS_DB_PASSWORD=vds
VDS_HTTP_PORT=8080
VDS_JWT_SECRET=change-me-at-least-32-characters-long

VDS_BOOTSTRAP_ADMIN_USERNAME=admin
VDS_BOOTSTRAP_ADMIN_PASSWORD=change-me-12-chars-min
VDS_CRAWLER_USERNAME=crawler
VDS_CRAWLER_PASSWORD=change-me
# Учётные данные отдельного процесса обогащения в Docker.
# VDS_ENRICH_USERNAME=enricher
# VDS_ENRICH_PASSWORD=

# Краулер тарифов.
VDS_CRAWLER_ENABLED=false
# VDS_CRAWLER_ADAPTERS=provider-a,provider-b
# VDS_CRAWLER_INITIAL_DELAY_MINUTES=1
# VDS_CRAWLER_INTERVAL_HOURS=24
# VDS_CRAWLER_RUN_TIMEOUT_MINUTES=60
# VDS_DISCOVERY_MAX_SOURCES=1000
# Необязательно: адрес для связи, попадает в User-Agent при обходе чужих сайтов.
# VDS_CRAWLER_CONTACT_URL=https://example.org/contact

# Discovery допускает ручной запуск. Первый запуск по расписанию отложен.
VDS_DISCOVERY_ENABLED=true
VDS_DISCOVERY_INITIAL_DELAY_MINUTES=100000
VDS_DISCOVERY_INTERVAL_HOURS=100000
VDS_DISCOVERY_MAX_CREDITS_PER_MONTH=10
VDS_DISCOVERY_MAX_QUERIES_PER_PASS=2
VDS_DISCOVERY_MAX_NEW_CANDIDATES_PER_PASS=10
VDS_DISCOVERY_STATE_FILE=/absolute/path/to/state/discovery-state.json
VDS_DISCOVERY_SOURCES_DIR=/absolute/path/to/sources
