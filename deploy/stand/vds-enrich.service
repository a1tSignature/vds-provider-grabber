# Set WorkingDirectory to the stand directory before installing this unit with vds-enrich.timer. See README §9.
[Unit]
Description=vds-provider-grabber site enrichment (one launch)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vds-stand
ExecStart=/usr/bin/docker compose --profile enrich run --rm --no-deps enrich
